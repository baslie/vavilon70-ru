---
// Подвал: контакты, соцсети и разделы сайта. Светлое поле после тёмного CTA.
// На общей сетке четыре колонки по 3: контакты и три колонки разделов через subgrid.
import Logo from './Logo.astro';
import BookingLink from './BookingLink.astro';
import { contacts, socials } from '../data/content';
import { menu, url } from '../data/nav';

// Разделы с подменю раскладываются в колонки, остальное — в колонку «Комплекс».
const columns = menu
  .filter((item) => item.groups)
  .map((item) => ({ title: item.title, links: item.groups!.flatMap((g) => g.links) }));
const year = new Date().getFullYear();
---

<footer id="kontakty" class="px-4 pt-16 pb-8 md:px-8">
  <div class="grid-site gap-y-14">
    <div class="lg:col-span-3">
      <Logo class="w-32" caption />
      <p class="mt-10 text-lg leading-relaxed">{contacts.address}<br />{contacts.place}</p>
      <a href={contacts.phoneHref} class="mt-4 inline-block font-display text-3xl font-bold transition hover:text-violet">{contacts.phone}</a>
      <ul class="label mt-8 flex gap-6 font-semibold">
        {socials.map((s) => <li><a href={s.href} class="underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-signal">{s.title}</a></li>)}
      </ul>
    </div>

    <nav class="grid gap-x-gutter gap-y-10 sm:grid-cols-3 lg:col-span-9 lg:grid-cols-subgrid" aria-label="Разделы сайта">
      {columns.map((col) => (
        <div class="lg:col-span-3">
          <h2 class="label font-semibold text-violet">{col.title}</h2>
          <ul class="mt-5 grid gap-3 text-ink/75">
            {col.links.map((l) => <li><a href={l.href} class="transition hover:text-ink">{l.title}</a></li>)}
          </ul>
        </div>
      ))}
      <div class="lg:col-span-3">
        <h2 class="label font-semibold text-violet">Комплекс</h2>
        <ul class="mt-5 grid gap-3 text-ink/75">
          <li><a href={url('/o-centre/')} class="transition hover:text-ink">О центре</a></li>
          <li><a href={url('/kafe/')} class="transition hover:text-ink">Семейное кафе</a></li>
          <li><BookingLink class="transition hover:text-ink">Онлайн-запись</BookingLink></li>
        </ul>
      </div>
    </nav>
  </div>

  <p class="mt-16 text-sm text-ink/55">© {year} «Вавилон», спортивно-развлекательный комплекс, Томск</p>
</footer>
