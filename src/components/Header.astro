---
// Шапка по ТЗ: «Услуги и цены» и «Праздники» раскрываются панелью на всю ширину,
// на мобильном — полноэкранное меню. Пункты и адреса в src/data/nav.ts.
// Шапка липкая: всегда сверху на сплошном фоне. С началом прокрутки (data-scrolled) отбрасывает тень,
// становится ниже, а логотип уменьшается и теряет подпись.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BookingLink from './BookingLink.astro';
import { hero, contacts } from '../data/content';
import { menu } from '../data/nav';

interface Props {
  tone?: 'dark' | 'light';
}

// tone: цвет текста шапки. dark — на светлом фоне, light — на тёмном.
const { tone = 'dark' } = Astro.props;
const light = tone === 'light';
---

<header class:list={['site-header sticky top-0 z-30 flex h-22 items-center justify-between gap-6 px-4 md:px-8', light ? 'bg-ink' : 'bg-mist']} data-header>
  <Logo class="w-28 md:w-32" caption tone={tone} />

  <nav class="hidden lg:block" aria-label="Основное меню">
    <ul class:list={['label flex items-center gap-5 whitespace-nowrap xl:gap-7', light ? 'text-paper/75' : 'text-ink/70']}>
      {menu.map((item, i) => item.groups ? (
        <li data-dropdown>
          <button type="button" class:list={['inline-flex items-center gap-1.5 uppercase transition-colors', light ? 'hover:text-paper aria-expanded:text-lime' : 'hover:text-ink aria-expanded:text-violet']} aria-expanded="false" aria-controls={`mega-${i}`}>
            {item.title}<Icon name="caretDown" class="caret size-3" />
          </button>
          <div id={`mega-${i}`} class:list={['mega absolute inset-x-0 top-full border-b px-8 pt-10 pb-12 normal-case tracking-normal whitespace-normal', light ? 'border-paper/10 bg-ink text-paper shadow-[0_24px_48px_-24px_rgb(0_0_0/0.6)]' : 'border-ink/10 bg-mist text-ink shadow-[0_24px_48px_-24px_rgb(14_14_17/0.25)]']}>
            {/* Общая сетка: четыре группы по 2 колонки с 5-й, три группы по 3 колонки с 4-й (subgrid). */}
            <div class="grid-site">
              <a href={item.href} class="group col-span-3 flex flex-col justify-between">
                <span class="headline text-3xl xl:text-4xl">{item.title}</span>
                <span class="label mt-8 inline-flex items-center gap-2 font-semibold">Весь раздел<Icon name="arrowUpRight" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></span>
              </a>
              <div class:list={['grid grid-cols-subgrid', item.groups.length === 4 ? 'col-span-8 col-start-5' : 'col-span-9 col-start-4']}>
                {item.groups.map((g) => (
                  <div class:list={['row-span-2 grid grid-rows-subgrid border-t pt-5', item.groups.length === 4 ? 'col-span-2' : 'col-span-3', light ? 'border-paper/15' : 'border-ink/15']}>
                    {g.href ? (
                      <a href={g.href} class:list={['group/g label font-semibold', light ? 'text-lime' : 'text-violet']}>{g.title}<Icon name="arrowUpRight" class="ml-1.5 inline-block size-3.5 align-[-0.15em] transition-transform group-hover/g:translate-x-0.5 group-hover/g:-translate-y-0.5" /></a>
                    ) : (
                      <p class:list={['label font-semibold', light ? 'text-lime' : 'text-violet']}>{g.title}</p>
                    )}
                    <ul class="mt-4 grid content-start gap-3 text-[0.95rem]">
                      {g.links.map((l) => <li><a href={l.href} class:list={['transition-colors', light ? 'text-paper/80 hover:text-lime' : 'text-ink/80 hover:text-violet']}>{l.title}</a></li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </li>
      ) : (
        <li><a href={item.href} class:list={['transition-colors', light ? 'hover:text-paper' : 'hover:text-ink']}>{item.title}</a></li>
      ))}
    </ul>
  </nav>

  <div class="flex items-center gap-3">
    {/* Телефон и запись по ТЗ. До lg запись в мобильном меню, телефон на мобильном — только иконка, на lg тоже: не хватает места рядом с меню. */}
    <a href={contacts.phoneHref} class:list={['btn-skew label inline-flex size-11 items-center gap-2 justify-center rounded-md border font-semibold transition active:scale-[0.98] sm:size-auto sm:px-5 sm:py-3 lg:size-11 lg:p-0 xl:size-auto xl:px-5 xl:py-3', light ? 'border-paper/30 text-paper hover:border-paper' : 'border-ink/20 hover:border-ink']} aria-label={`Позвонить: ${contacts.phone}`}><span><Icon name="phone" class="size-4" /><span class="hidden sm:inline lg:hidden xl:inline">{contacts.phone}</span></span></a>
    <BookingLink class="btn-skew label hidden items-center rounded-md bg-violet px-5 py-3 font-semibold text-paper transition hover:bg-violet-deep active:scale-[0.98] lg:inline-flex">
      <span>{hero.primary}</span>
    </BookingLink>
    <button type="button" class:list={['grid size-11 place-items-center rounded-md border lg:hidden', light ? 'border-paper/25 text-paper' : 'border-ink/20']} aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu" data-menu-open><Icon name="list" /></button>
  </div>

  <div id="mobile-menu" class="mobile-menu fixed inset-0 z-50 flex flex-col overflow-y-auto bg-ink text-paper lg:hidden" role="dialog" aria-modal="true" aria-label="Меню" hidden>
    <div class="flex h-22 shrink-0 items-center justify-between px-4 md:px-8">
      <Logo class="w-28 md:w-32" caption tone="light" />
      <button type="button" class="grid size-11 place-items-center rounded-md border border-paper/25" aria-label="Закрыть меню" data-menu-close><Icon name="close" /></button>
    </div>
    <ul class="grow px-4 pt-4 pb-10 md:px-8">
      {menu.map((item) => (
        <li class="border-t border-paper/15">
          {item.groups ? (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-5 font-display text-2xl font-bold uppercase [&::-webkit-details-marker]:hidden">
                {item.title}<Icon name="caretDown" class="size-5 transition-transform group-open:rotate-180" />
              </summary>
              <div class="grid gap-7 pb-8 sm:grid-cols-2">
                {item.groups.map((g) => (
                  <div>
                    {g.href ? (
                      <a href={g.href} class="label font-semibold text-lime">{g.title}<Icon name="arrowUpRight" class="ml-1.5 inline-block size-3.5 align-[-0.15em]" /></a>
                    ) : (
                      <p class="label font-semibold text-lime">{g.title}</p>
                    )}
                    <ul class="mt-3 grid gap-3 text-lg text-paper/80">
                      {g.links.map((l) => <li><a href={l.href} class="hover:text-lime">{l.title}</a></li>)}
                    </ul>
                  </div>
                ))}
                <a href={item.href} class="label inline-flex items-center gap-2 font-semibold sm:col-span-2">Весь раздел<Icon name="arrowUpRight" class="size-4" /></a>
              </div>
            </details>
          ) : (
            <a href={item.href} class="block py-5 font-display text-2xl font-bold uppercase">{item.title}</a>
          )}
        </li>
      ))}
    </ul>
    <div class="grid gap-5 border-t border-paper/15 px-4 py-8 md:px-8">
      <BookingLink class="btn-skew label inline-flex items-center justify-center gap-3 rounded-md bg-violet px-6 py-4 font-semibold text-paper transition hover:bg-violet-deep active:scale-[0.98]">
        <span>{hero.primary}<Icon name="arrowUpRight" class="size-4" /></span>
      </BookingLink>
      <a href={contacts.phoneHref} class="font-display text-2xl font-bold">{contacts.phone}</a>
      <p class="label text-paper/60">{contacts.address}, {contacts.place}</p>
    </div>
  </div>
</header>

<style>
  /* Фиолетовые подписи 12px на тёмном не добирают контраста AA, там подписи лаймовые (docs/BRAND.md). */
  /* Панель меню: появляется сверху, без JS остаётся скрытой (пункты ведут на страницы разделов).
     Фон как у шапки, от страницы отделена нижней границей и тенью. */
  .mega {
    visibility: hidden;
    opacity: 0;
    translate: 0 -8px;
    transition: opacity 0.2s, translate 0.2s var(--ease-out-expo), visibility 0s 0.2s;
  }
  [data-dropdown][data-open] .mega {
    visibility: visible;
    opacity: 1;
    translate: none;
    transition: opacity 0.2s, translate 0.2s var(--ease-out-expo);
  }
  .caret { transition: rotate 0.2s; }

  /* Компактная шапка: плашка 4rem, а недостающие 1.5rem уходят в отступ снизу, чтобы в потоке
     шапка по-прежнему занимала 5.5rem и контент под ней не дёргался. */
  .site-header {
    transition: height 0.3s var(--ease-out-expo), margin-bottom 0.3s var(--ease-out-expo), box-shadow 0.3s;
  }
  .site-header[data-scrolled] {
    height: 4rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 12px 32px -20px rgb(14 14 17 / 0.35);
  }
  /* Знак занимает верхние 77 из 111 единиц логотипа: сдвиг вниз ставит его по центру плашки. */
  .site-header > :global(a:first-child) {
    transform-origin: left center;
    transition: scale 0.3s var(--ease-out-expo), translate 0.3s var(--ease-out-expo);
  }
  .site-header[data-scrolled] > :global(a:first-child) {
    scale: 0.8;
    translate: 0 12%;
  }
  .site-header :global([data-logo-caption]) { transition: opacity 0.2s; }
  .site-header[data-scrolled] :global([data-logo-caption]) { opacity: 0; }
  [data-dropdown][data-open] .caret { rotate: 180deg; }

  .mobile-menu:not([hidden]) { animation: menu-in 0.25s var(--ease-out-expo); }
  @keyframes menu-in {
    from { opacity: 0; translate: 0 -12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega, [data-dropdown][data-open] .mega, .caret, .site-header, .site-header > :global(a:first-child), .site-header :global([data-logo-caption]) { transition: none; }
    .mobile-menu:not([hidden]) { animation: none; }
  }
</style>

<script>
  // Выпадающие панели: наведение (на устройствах с мышью), клик, клавиатура, Esc и клик мимо.
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const hoverable = matchMedia('(hover: hover)');
  let closeTimer: number | undefined;

  const setOpen = (dd: HTMLElement, open: boolean) => {
    dd.toggleAttribute('data-open', open);
    dd.querySelector('button')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except?: HTMLElement) => dropdowns.forEach((dd) => dd !== except && setOpen(dd, false));

  dropdowns.forEach((dd) => {
    const button = dd.querySelector('button')!;
    button.addEventListener('click', () => {
      const open = !dd.hasAttribute('data-open');
      closeAll(dd);
      setOpen(dd, open);
    });
    dd.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      clearTimeout(closeTimer);
      closeAll(dd);
      setOpen(dd, true);
    });
    // Небольшая задержка, чтобы курсор успел дойти от пункта до панели.
    dd.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      closeTimer = window.setTimeout(() => setOpen(dd, false), 200);
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) setOpen(dd, false);
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-dropdown]')) closeAll();
  });

  // Тень у липкой шапки, когда под ней уже идёт контент.
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Мобильное меню на весь экран: блокирует прокрутку страницы, закрывается по Esc, крестику и ссылке.
  const panel = document.getElementById('mobile-menu')!;
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeButton = panel.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const setMenu = (open: boolean) => {
    panel.hidden = !open;
    openButton.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('overflow-hidden', open);
    (open ? closeButton : openButton).focus();
  };
  openButton.addEventListener('click', () => setMenu(true));
  closeButton.addEventListener('click', () => setMenu(false));
  panel.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  // Меню открыто, а окно растянули до десктопа: закрываем, чтобы не осталась блокировка прокрутки.
  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && !panel.hidden && setMenu(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!panel.hidden) return setMenu(false);
    const open = dropdowns.find((dd) => dd.hasAttribute('data-open'));
    if (open) {
      setOpen(open, false);
      open.querySelector('button')?.focus();
    }
  });
</script>
