---
// Логотип «Вавилон» из векторного исходника заказчика (src/data/logo.ts).
// На светлом фоне: чёрные буквы, белая подложка, фиолетовая обводка. На тёмном: белые буквы.
import { logoOnLight, logoOnDark } from '../data/logo';

interface Props {
  class?: string;
  /** Подпись «спортивно-развлекательный комплекс» под знаком. */
  caption?: boolean;
  /** dark — логотип для светлого фона, light — для тёмного. */
  tone?: 'dark' | 'light';
}

const { class: className = 'w-36', caption = false, tone = 'dark' } = Astro.props;
const logo = tone === 'dark' ? logoOnLight : logoOnDark;
const { x, y, w, mark, full } = logo.viewBox;
const h = caption ? full : mark;
---

<a href={import.meta.env.BASE_URL} class:list={['inline-block', className]} aria-label="Вавилон, на главную">
  <svg viewBox={`${x} ${y} ${w} ${h}`} class="block h-auto w-full" aria-hidden="true">
    {logo.backing && <path d={logo.backing} fill="#fff" />}
    <path d={logo.ring} fill="var(--color-violet)" fill-rule="evenodd" />
    <path d={logo.letters} fill={tone === 'dark' ? '#000' : '#fff'} fill-rule="evenodd" />
    {caption && <path d={logo.caption} fill={tone === 'dark' ? '#1B1918' : '#fff'} fill-rule="evenodd" />}
  </svg>
</a>
