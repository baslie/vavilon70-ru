---
// Первый экран из v1 «Брендбук», утверждён 21.10.2026: заголовок слева, фото по центру, справа три фото.
// По замечаниям 26.10 справа остались только три фото: подписи внутри кадра по варианту 04 «Полоса»
// из /variants/captions/ (скошенная сиреневая полоса над белым капсом на тёмном градиенте),
// запись и телефон не дублируем — кнопка записи слева.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import BookingLink from '../BookingLink.astro';
import { partyRequest } from '../../data/nav';
import { hero, homeLead, contacts, slogans } from '../../data/content';
import { photos, alts } from '../../data/photos';

interface Props {
  /** Подзаголовок: на главной из ТЗ, в v7 прежний hero.lead. */
  lead?: string;
}

const { lead = homeLead } = Astro.props;

const details = [
  { photo: photos.arena, caption: 'Батутная арена' },
  { photo: photos.ninja, caption: 'Ninja-трасса' },
  { photo: photos.party, caption: 'Праздники' },
];
---

<section class="grid-site gap-y-10 px-4 pt-4 pb-12 md:px-8 lg:h-[calc(100dvh-5.5rem)] lg:min-h-[620px] lg:pb-8">
  <div class="flex flex-col justify-between gap-10 lg:col-span-4">
    {/* Заголовок посередине свободного места над нижним блоком, а не прижат к шапке. */}
    <div class="lg:my-auto">
      <h1 class="headline text-[clamp(2.75rem,4.7vw,7rem)]">
        <span class="block">Больше</span>
        <span class="block">чем прыжки</span>
      </h1>
      {/* На узком экране разрядка и зазор меньше, чтобы «Вавилон» не висел один на второй строке. */}
      <p class="label mt-6 flex flex-wrap gap-x-2 tracking-[0.12em] text-ink/60 sm:gap-x-3 sm:tracking-[0.22em]">
        {slogans.values.map((w, i) => <>{i > 0 && <span class="text-ink/30">/</span>}<span>{w}</span></>)}
      </p>
    </div>

    <div class="grid gap-7">
      <p class="text-lg leading-relaxed text-ink/75">{lead}</p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
        <BookingLink class="btn-skew label inline-flex items-center gap-3 rounded-md bg-violet px-6 py-4 font-semibold text-paper transition hover:bg-violet-deep active:scale-[0.98]">
          <span>{hero.primary}<Icon name="arrowUpRight" class="size-4" /></span>
        </BookingLink>
        <a href={partyRequest} class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">{hero.secondary}</a>
      </div>
      <p class="label flex items-start gap-3 text-ink/60"><Icon name="mapPin" class="mt-0.5 size-4 shrink-0 text-violet" /><span>{contacts.address}<br />{contacts.place}</span></p>
    </div>
  </div>

  <figure class="relative lg:col-span-5 lg:min-h-0">
    <Image src={photos.jumpTall} alt={alts.jumpTall} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" quality={82} class="aspect-[4/5] w-full rounded-md object-cover lg:aspect-auto lg:h-full" />
  </figure>

  <aside class="hidden lg:col-span-3 lg:flex lg:min-h-0" aria-label="Детали">
    <ul class="flex min-h-0 flex-1 flex-col gap-4">
      {details.map((d) => (
        <li class="relative flex min-h-0 flex-1 overflow-hidden rounded-md">
          <Image src={d.photo} alt="" widths={[400, 700]} sizes="22vw" class="min-h-0 w-full flex-1 object-cover" />
          <span class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-ink/85 to-transparent"></span>
          <p class="absolute bottom-4 left-4">
            <span class="dash block bg-violet"></span>
            <span class="label mt-2 block text-[0.7rem] font-semibold text-paper">{d.caption}</span>
          </p>
        </li>
      ))}
    </ul>
  </aside>
</section>
