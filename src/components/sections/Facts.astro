---
// Цифры из v3 «Постер»: крупные чёрные цифры Unbounded, единица в том же заголовке фиолетовым помельче, без линий.
// Заголовок строчными: капс превратил бы м² в М², а 1-я в 1-Я.
// На телефоне единица всегда отдельной строкой: в полколонки она то влезает, то нет, и ряд рассыпается.
// На общей сетке: четыре факта встают в ряд по 3 колонки, шесть — сеткой 3×2 по 4 колонки.
// Подписи прижаты к низу ячейки: если длинная единица («100% безопасность») уходит на вторую строку,
// цифры ряда остаются на одной линии сверху, подписи — на одной линии снизу.
import { facts } from '../../data/content';

interface Props {
  items?: typeof facts;
}

const { items = facts } = Astro.props;
const four = items.length === 4;
---

<section class="px-4 py-20 md:px-8" aria-label="Вавилон в цифрах">
  <div class:list={['grid-site grid-cols-2 gap-y-12 lg:grid-cols-12', !four && 'lg:gap-y-16']}>
    {items.map((f, i) => (
      <div class:list={['flex flex-col', four ? 'lg:col-span-3' : 'lg:col-span-4']} data-reveal style={`--i:${i % (four ? 4 : 3)}`}>
        <h3 class="headline normal-case text-[2.6rem] sm:text-6xl md:text-7xl">
          {f.value} <span class="mt-2 block text-[0.42em] text-violet md:mt-0 md:inline">{f.unit}</span>
        </h3>
        <p class="mt-auto pt-3 text-sm leading-relaxed text-ink/65">{f.label}</p>
      </div>
    ))}
  </div>
</section>
