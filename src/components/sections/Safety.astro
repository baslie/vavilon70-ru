---
// «Спокойно за детей» из v3 «Постер»: тёмный блок, фото тренера слева, справа вводный текст из ТЗ
// на уровне заголовка и четыре пункта с красными тире на уровне низа фото.
import { Image } from 'astro:assets';
import { safety, safetyLead } from '../../data/content';
import { photos, alts } from '../../data/photos';
---

<section class="grid gap-12 bg-ink px-4 py-24 text-paper md:px-8 lg:grid-cols-12 lg:gap-8">
  <div class="lg:col-span-5">
    <h2 class="headline text-[2.6rem] sm:text-5xl md:text-6xl" data-reveal>Спокойно<br />за детей</h2>
    <Image src={photos.coach} alt={alts.coach} widths={[600, 900]} sizes="(min-width: 1024px) 40vw, 100vw" class="mt-10 aspect-[4/3] w-full rounded-md object-cover" data-reveal />
  </div>
  <div class="flex flex-col justify-between gap-12 lg:col-span-6 lg:col-start-7">
    <p class="max-w-[40ch] font-display text-xl leading-snug text-paper/85 md:text-2xl lg:text-[1.9rem]" data-reveal>{safetyLead}</p>
    <ol class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {safety.map((s, i) => (
        <li class="border-t border-paper/20 pt-6" data-reveal style={`--i:${i}`}>
          <span class="mb-5 block h-1 w-6 bg-signal" aria-hidden="true"></span>
          <h3 class="font-display text-lg font-bold uppercase">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-paper/70">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
