---
// «Спокойно за детей» из v3 «Постер»: фото тренера слева, справа вводный текст из ТЗ
// на уровне заголовка и четыре пункта с красными тире. Фото тянется до низа пунктов, чтобы
// под ним не оставалось пустоты (docs/BRAND.md, «Баланс блока»).
// На главной светлый вариант с заголовком и пунктами из ТЗ: заказчик просил спокойный тон «для родителей».
// В v7 — тёмный, с прежними заголовком и пунктами.
// Сетка: слева 5 колонок, 6-я — воздух, справа 6 колонок через subgrid, пункты по 3 —
// на тех же вертикалях, что третья и четвёртая колонки четырёхколоночной раскладки.
import { Image } from 'astro:assets';
import Headline from '../blocks/Headline.astro';
import { safetyHome, safetyLead } from '../../data/content';
import { photos, alts } from '../../data/photos';

interface Props {
  title?: string;
  items?: { title: string; text: string }[];
  tone?: 'dark' | 'light';
}

const { title = safetyHome.title, items = safetyHome.items, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
// Короткий заголовок прототипа — плакатным кеглем в две строки, длинный из ТЗ — ключом и контекстом
// (Headline.astro): «Профессиональный подход к» строчными, «безопасности каждого гостя» плакатом.
const long = title.length > 20;
---

<section class:list={['grid-site gap-y-12 px-4 py-24 md:px-8', dark && 'bg-ink text-paper']}>
  <div class="flex flex-col gap-10 lg:col-span-5">
    {long ? (
      <Headline text={title} size="clamp(1.9rem,3.2vw,3.5rem)" span={5} class="leading-[1.02]" data-reveal />
    ) : (
      <h2 class="headline text-[2.6rem] sm:text-5xl md:text-6xl" data-reveal>
        {title.slice(0, title.indexOf(' '))}<br />{title.slice(title.indexOf(' ') + 1)}
      </h2>
    )}
    <div class="relative aspect-[4/3] overflow-hidden rounded-md lg:aspect-auto lg:min-h-72 lg:flex-1" data-reveal>
      <Image src={photos.coach} alt={alts.coach} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" class="absolute inset-0 size-full object-cover" />
    </div>
  </div>
  <div class="grid content-between gap-y-12 lg:col-span-6 lg:col-start-7 lg:grid-cols-subgrid">
    <p class:list={['max-w-[40ch] font-display text-xl leading-snug md:text-2xl lg:col-span-6 lg:text-[1.9rem]', dark ? 'text-paper/85' : 'text-ink/85']} data-reveal>{safetyLead}</p>
    <ol class="grid gap-x-gutter gap-y-12 sm:grid-cols-2 lg:col-span-6 lg:grid-cols-subgrid">
      {items.map((s, i) => (
        <li class="lg:col-span-3" data-reveal style={`--i:${i}`}>
          <span class:list={['dash mb-5 block', dark ? 'bg-lime' : 'bg-signal']} aria-hidden="true"></span>
          <h3 class="subhead">{s.title}</h3>
          <p class:list={['mt-3 leading-relaxed', dark ? 'text-paper/70' : 'text-ink/70']}>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
