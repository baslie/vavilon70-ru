---
// Блок 5 главной «Призыв к действию»: тёмное поле на высоту окна, запись онлайн и заявка на праздник.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import BookingLink from '../BookingLink.astro';
import { planVisit, contacts } from '../../data/content';
import { partyRequest } from '../../data/nav';
import { photos, alts } from '../../data/photos';
---

<section id="plan" class="grid gap-12 bg-ink px-4 py-24 text-paper md:px-8 lg:min-h-dvh lg:grid-cols-12 lg:gap-8">
  <div class="flex flex-col justify-center lg:col-span-7">
    <h2 class="headline text-[clamp(2rem,5vw,5.5rem)]" data-reveal>{planVisit.title}</h2>
    <p class="mt-8 max-w-[54ch] text-lg leading-relaxed text-paper/70" data-reveal style="--i:1">{planVisit.text}</p>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--i:2">
      <BookingLink class="label inline-flex w-full items-center justify-center gap-3 rounded-md bg-violet px-4 py-4 font-semibold tracking-[0.12em] text-center sm:tracking-[0.22em] text-paper transition hover:bg-violet-deep active:scale-[0.98] sm:w-auto sm:px-6">
        <Icon name="lightning" class="size-4" />{planVisit.book}
      </BookingLink>
      <a href={partyRequest} class="label inline-flex w-full items-center justify-center gap-3 rounded-md border border-paper/30 px-4 py-4 tracking-[0.12em] text-center sm:tracking-[0.22em] sm:w-auto sm:px-6 font-semibold transition hover:border-paper hover:bg-paper hover:text-ink active:scale-[0.98]">
        <Icon name="confetti" class="size-4" />{planVisit.party}
      </a>
    </div>
    <p class="label mt-8 flex items-center gap-3 text-paper/60" data-reveal style="--i:3">
      <Icon name="phone" class="size-4 text-violet" />Администратор
      <a href={contacts.phoneHref} class="font-semibold text-paper underline decoration-paper/25 underline-offset-[6px] transition hover:decoration-signal">{contacts.phone}</a>
    </p>
  </div>
  <Image src={photos.jump} alt={alts.jump} widths={[600, 900]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover lg:col-span-5 lg:aspect-auto lg:h-full" data-reveal />
</section>
