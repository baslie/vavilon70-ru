---
// Манифест из ТЗ: вводная фраза, шесть направлений и философия «Больше чем прыжки».
// Светлое поле после тёмных «Спокойно за детей» и «Что внутри».
import { manifest } from '../../data/content';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="o-centre" class="px-4 py-24 md:px-8" aria-labelledby="manifest-title">
  <h2 id="manifest-title" class="max-w-[24ch] font-display text-[1.6rem] leading-[1.2] font-semibold sm:text-4xl lg:text-[2.9rem]" data-reveal>
    {manifest.lead} <span class="text-violet">{manifest.accent}</span> {manifest.tail}
  </h2>

  <ol class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
    {manifest.items.map((item, i) => (
      <li class="border-t border-ink/15 pt-6" data-reveal style={`--i:${i % 3}`}>
        <span class="label font-semibold text-violet">{pad(i + 1)}</span>
        <h3 class="mt-4 font-display text-lg font-bold uppercase md:text-xl">{item.title}</h3>
        <p class="mt-3 max-w-[40ch] leading-relaxed text-ink/70">{item.text}</p>
      </li>
    ))}
  </ol>

  <div class="mt-24 grid gap-10 lg:mt-32 lg:grid-cols-12 lg:items-end lg:gap-8">
    <div class="lg:col-span-8" data-reveal>
      <p class="label font-semibold text-violet">Наша философия</p>
      <p class="headline mt-6 text-[clamp(2.6rem,6vw,6rem)]">
        <span class="block">Больше</span>
        <span class="block">чем прыжки</span>
      </p>
    </div>
    <div class="lg:col-span-4" data-reveal style="--i:1">
      <span class="mb-5 block h-1 w-6 bg-signal" aria-hidden="true"></span>
      <p class="max-w-[34ch] text-lg leading-relaxed text-ink/75">{manifest.philosophy}</p>
    </div>
  </div>
</section>
