---
// Манифест из ТЗ: вводная фраза и шесть направлений. Философия — отдельным светлым блоком Philosophy.astro.
// Тёмное поле сразу под светлым первым экраном, как в порядке ТЗ. Справа от вводной фразы фото, чтобы не провисала пустота.
// На общей сетке: вводная и фото 8 + 4, шесть пунктов по 4 колонки — фото и третья колонка пунктов
// стоят на одной вертикали.
// Номера и подписи лаймом: фиолетовый 12px на тёмном не добирает контраста AA (docs/BRAND.md).
import { Image } from 'astro:assets';
import { manifest } from '../../data/content';
import { photos, alts } from '../../data/photos';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="o-centre" class="bg-ink px-4 py-24 text-paper md:px-8" aria-labelledby="manifest-title">
  <div class="grid-site gap-y-10">
    <h2 id="manifest-title" class="max-w-[24ch] font-display text-[1.6rem] leading-[1.2] font-semibold sm:text-4xl lg:col-span-8 lg:text-[2.9rem]" data-reveal>
      {manifest.lead} <span class="text-violet">{manifest.accent}</span> {manifest.tail}
    </h2>
    <Image src={photos.football} alt={alts.football} widths={[600, 900]} sizes="(min-width: 1024px) 33vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover lg:col-span-4 lg:aspect-auto lg:h-full" data-reveal style="--i:1" />
  </div>

  <ol class="grid-site mt-16 gap-y-12 md:grid-cols-2 lg:mt-20 lg:grid-cols-12">
    {manifest.items.map((item, i) => (
      <li class="border-t border-paper/15 pt-6 lg:col-span-4" data-reveal style={`--i:${i % 3}`}>
        <span class="label font-semibold text-lime">{pad(i + 1)}</span>
        <h3 class="mt-4 font-display text-lg font-bold uppercase md:text-xl">{item.title}</h3>
        <p class="mt-3 max-w-[40ch] leading-relaxed text-paper/70">{item.text}</p>
      </li>
    ))}
  </ol>

</section>
