---
// Полоса из параллелограммов из брендбука: фиолетовый, красный, чёрный, белый.
interface Props {
  class?: string;
  /** На тёмном фоне чёрный сегмент получает контур, иначе он теряется. */
  onDark?: boolean;
}

const { class: className = 'h-6 w-56', onDark = false } = Astro.props;
const colors = ['bg-violet', 'bg-signal', onDark ? 'bg-ink ring-1 ring-inset ring-paper/40' : 'bg-ink', 'bg-paper'];
---

<span class:list={['flex gap-1', className]} aria-hidden="true">
  {colors.map((c) => <span class:list={['h-full flex-1 -skew-x-[28deg]', c]}></span>)}
</span>
