---
// Плитка карточек-ссылок для разделов «Услуги и цены» и «Праздники»: фото, название со стрелкой,
// подпись и «от N ₽». Три карточки в ряд по 4 колонки, ниже lg — две.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { photos, alts } from '../../data/photos';
import type { PhotoKey } from '../../data/content';

export type Card = { title: string; text: string; href: string; photo?: PhotoKey; meta?: string };

interface Props {
  id?: string;
  title: string;
  items: Card[];
  tone?: 'light' | 'dark';
}

const { id, title, items, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<section id={id} class:list={['px-4 py-20 md:px-8 lg:py-24', dark && 'bg-ink text-paper']}>
  <h2 class="headline text-[clamp(1.9rem,3.6vw,3.75rem)] leading-[1.02]" data-reveal>{title}</h2>
  <ul class="grid-site mt-12 gap-y-12 md:grid-cols-2">
    {items.map((c, i) => (
      <li class="lg:col-span-4" data-reveal style={`--i:${i % 3}`}>
        <a href={c.href} class="group block">
          <div class="overflow-hidden rounded-md">
            <Image src={photos[c.photo ?? 'textureAlt']} alt={c.photo ? alts[c.photo] : ''} widths={[480, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <h3 class="mt-6 flex items-start justify-between gap-4 font-display text-xl font-bold uppercase">
            {c.title}
            <Icon name="arrowUpRight" class:list={['size-6 shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1', dark ? 'text-lime' : 'text-violet']} />
          </h3>
          <p class:list={['mt-3 leading-relaxed', dark ? 'text-paper/70' : 'text-ink/70']}>{c.text}</p>
          {c.meta && <p class:list={['label mt-4 font-semibold', dark ? 'text-lime' : 'text-violet']}>{c.meta}</p>}
        </a>
      </li>
    ))}
  </ul>
</section>
