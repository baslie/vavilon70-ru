---
// Мероприятие с пакетами: день рождения 18+, корпоративы, украшение зоны кафе. Слева плашка,
// слоган и текст, справа преимущества, ниже пакеты на всю ширину и кнопка.
import Badge from './Badge.astro';
import Headline from './Headline.astro';
import Packages from './Packages.astro';
import Button from './Button.astro';
import type { EventBlock } from '../../data/parties';

interface Props {
  event: EventBlock;
  tone?: 'light' | 'dark';
  cta?: { label: string; href: string };
}

const { event, tone = 'light', cta } = Astro.props;
const dark = tone === 'dark';
const muted = dark ? 'text-paper/70' : 'text-ink/70';
---

<section id={event.id} class:list={['grid-site gap-y-12 px-4 py-20 md:px-8 lg:py-24', dark && 'bg-ink text-paper']}>
  <div class="lg:col-span-5">
    <p data-reveal><Badge tone={tone}>{event.title}</Badge></p>
    <Headline text={event.tagline} tone={tone} size="clamp(1.9rem,3.2vw,3.5rem)" span={5} class="mt-6 leading-[1.02]" data-reveal />
    <p class:list={['mt-6 max-w-[52ch] text-lg leading-relaxed', muted]} data-reveal>{event.text}</p>
  </div>
  {event.points && (
    <ul class="grid content-end gap-8 lg:col-span-6 lg:col-start-7">
      {event.points.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class:list={['dash mb-4 block', dark ? 'bg-lime' : 'bg-signal']} aria-hidden="true"></span>
          <p class="subhead">{p.title}</p>
          <p class:list={['mt-2 leading-relaxed', muted]}>{p.text}</p>
        </li>
      ))}
    </ul>
  )}
  <div class="lg:col-span-12" data-reveal>
    <Packages packages={event.packages} tone={tone} />
  </div>
  {cta && <div class="lg:col-span-12" data-reveal><Button href={cta.href} icon="confetti">{cta.label}</Button></div>}
</section>
