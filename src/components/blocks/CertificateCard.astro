---
// Макет подарочного сертификата для первого экрана /uslugi/sertifikaty/: вёрстка, а не фото —
// чёткая на любой ширине. Фиолетовая карта со знаком «Вавилона» поверх лаймовой, на тёмном поле.
// Суммы нет: номинал выбирают при оформлении, на карте — услуги из ТЗ.
import { logoOnDark } from '../../data/logo';
import { contacts } from '../../data/content';

const { x, y, w, mark } = logoOnDark.viewBox;
const services = ['Абонемент в секцию', 'Персональная тренировка', 'Комплексный билет'];
---

<div class="grid h-full min-h-[22rem] place-items-center overflow-hidden rounded-md bg-ink px-6 py-14 sm:px-12 lg:min-h-0" aria-hidden="true">
  <div class="relative w-full max-w-[34rem]">
    <div class="absolute inset-0 translate-x-4 translate-y-4 rotate-3 rounded-md bg-lime sm:translate-x-6 sm:translate-y-6"></div>
    <div class="relative flex aspect-[1.6] -rotate-2 flex-col justify-between rounded-md bg-violet p-6 text-paper shadow-2xl sm:p-9">
      <div class="flex items-start justify-between gap-6">
        <svg viewBox={`${x} ${y} ${w} ${mark}`} class="w-24 sm:w-32">
          <path d={logoOnDark.ring} fill="var(--color-ink)" fill-rule="evenodd" />
          <path d={logoOnDark.letters} fill="#fff" fill-rule="evenodd" />
        </svg>
        <span class="label font-semibold text-lime">Подарок</span>
      </div>
      <div>
        <p class="headline text-[clamp(1.5rem,4.6vw,2.75rem)] leading-none">Сертификат</p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold sm:text-sm">
          {services.map((s) => <li class="flex items-center gap-2"><span class="dash block w-3 bg-lime"></span>{s}</li>)}
        </ul>
      </div>
      <p class="label text-paper/70">{contacts.place}</p>
    </div>
  </div>
</div>
