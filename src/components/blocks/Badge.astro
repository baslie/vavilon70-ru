---
// Плашка из ТЗ: «Популярный выбор», «18+», «1,5 часа». Цвет по фону (docs/BRAND.md, «Акценты»).
interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
---

<span class:list={['label inline-flex items-center rounded-md border px-3 py-1.5 font-semibold', tone === 'dark' ? 'border-lime/40 text-lime' : 'border-violet/30 bg-violet/5 text-violet']}><slot /></span>
