---
// Плашка из ТЗ: «Популярный выбор», «18+», «1,5 часа». Наклейка со скосом, как у кнопок: сплошная
// заливка без рамки, на светлом поле сиреневая, на тёмном лаймовая (docs/BRAND.md, «Акценты»).
interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
---

<span class:list={['btn-skew label ml-1 inline-flex items-center rounded-sm px-3 py-1.5 font-bold', tone === 'dark' ? 'bg-lime text-ink' : 'bg-violet text-paper']}><span><slot /></span></span>
