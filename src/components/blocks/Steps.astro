---
// Нумерованные шаги: подготовка к визиту (3), первая тренировка (5), предзаказ банкета (4).
// Заголовок слева на 4 колонки, шаги справа на 8, номера на линии верха заголовка: верхние углы
// блока заняты и без вводной. Внутри восьми колонок три шага — в ряд, четыре — по два,
// пять — три и два пошире. Вводная, если есть, — под заголовком, у низа ряда.
import Headline from './Headline.astro';
import DownloadLink from './DownloadLink.astro';
import type { Step } from '../../data/services';

interface Props {
  id?: string;
  title: string;
  lead?: string;
  items: Step[];
  tone?: 'light' | 'dark';
}

const { id, title, lead, items, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const n = items.length;
const span = (i: number) => (n === 4 || (n === 5 && i > 2) ? 'lg:col-span-3' : 'lg:col-span-2');
---

<section id={id} class:list={['grid-site gap-y-12 px-4 py-20 md:px-8 lg:py-24', dark && 'bg-ink text-paper']}>
  <div class="flex flex-col gap-8 lg:col-span-4">
    <Headline text={title} size="clamp(1.9rem,3.6vw,3.75rem)" span={4} class="leading-[1.02]" data-reveal />
    {lead && <p class:list={['max-w-[60ch] text-lg leading-relaxed lg:mt-auto', dark ? 'text-paper/70' : 'text-ink/70']} data-reveal>{lead}</p>}
  </div>
  <ol class="grid gap-x-gutter gap-y-12 md:grid-cols-2 lg:col-span-8 lg:grid-cols-6">
    {items.map((s, i) => (
      <li class={span(i)} data-reveal style={`--i:${i % 4}`}>
        <span class:list={['block font-display text-5xl leading-none font-extrabold italic', dark ? 'text-lime' : 'text-violet']} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="subhead mt-5">{s.title}</h3>
        <p class:list={['mt-3 max-w-[48ch] leading-relaxed', dark ? 'text-paper/70' : 'text-ink/70']}>{s.text}</p>
        {s.download && <p class="mt-5"><DownloadLink href={s.download.href} tone={tone}>{s.download.label}</DownloadLink></p>}
      </li>
    ))}
  </ol>
</section>
