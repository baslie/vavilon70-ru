---
// Форма заявки внизу страницы (src/data/forms.ts). Слева заголовок и пояснение, справа поля
// (RequestFields). Форма выше текста, поэтому крупный телефон — якорь внизу левой колонки,
// на линии кнопки отправки. Кнопки, которые ведут на #id этой секции, открывают ту же форму
// поп-апом (RequestDialog); topic — повод, выбранный по умолчанию. Светлая форма — на подложке paper,
// чтобы не сливаться с подвалом на поле mist.
import Headline from './Headline.astro';
import RequestFields from './RequestFields.astro';
import Icon from '../Icon.astro';
import { contacts } from '../../data/content';
import { forms, type RequestFormConfig } from '../../data/forms';

interface Props {
  id: string;
  form: RequestFormConfig;
  tone?: 'light' | 'dark';
  topic?: string;
}

const { id, form, tone = 'dark', topic } = Astro.props;
const formKey = Object.entries(forms).find(([, f]) => f === form)?.[0] ?? 'party';
const dark = tone === 'dark';
const muted = dark ? 'text-paper/70' : 'text-ink/70';
---

<section id={id} class:list={['grid-site gap-y-12 px-4 py-20 md:px-8 lg:py-24', dark ? 'bg-ink text-paper' : 'bg-paper']} data-request-section={formKey} data-topic={topic}>
  <div class="flex flex-col gap-10 lg:col-span-5">
    <div>
      <Headline text={form.title} tone={tone} size="clamp(1.9rem,3.2vw,3.5rem)" span={5} class="leading-[1.02]" data-reveal />
      <p class:list={['mt-6 max-w-[48ch] text-lg leading-relaxed', muted]} data-reveal>{form.text}</p>
    </div>
    <div class="lg:mt-auto" data-reveal>
      <p class:list={['label flex items-center gap-3', dark ? 'text-paper/60' : 'text-ink/60']}>
        <Icon name="phone" class={`size-4 ${dark ? 'text-lime' : 'text-violet'}`} />Или позвоните
      </p>
      <a href={contacts.phoneHref} class:list={['mt-3 inline-block font-display text-4xl font-bold transition lg:text-5xl', dark ? 'hover:text-lime' : 'hover:text-violet']}>{contacts.phone}</a>
    </div>
  </div>

  <RequestFields id={id} form={form} formKey={formKey} tone={tone} topic={topic} class="lg:col-span-6 lg:col-start-7" reveal />
</section>
