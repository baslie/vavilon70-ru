---
// Цены из ТЗ карточками тарифов, а не таблицей на всю колонку: на широком экране название и цена
// не разъезжаются по краям, каждая цена стоит рядом со своей подписью.
// Строк несколько — карточка на строку («1 час», «2 часа»), внутри цены «Будни / Выходные» группой
// слева. Строка одна, а колонок две (комплексный билет) — карточка на колонку, название строки уходит
// в подпись над карточками. Зачёркнутая старая цена в строку с новой, чтобы цены соседних карточек
// стояли на одной линии; пояснение под названием.
// Пустая цена (null) — «Уточняется» или своя подпись (table.empty).
// Ряды полные (docs/BRAND.md, «Баланс блока»): 2 и 4 карточки — по две в ряд, 3 и 6 — по три,
// 5 — три и две пошире. stretch: от lg карточки тянутся на высоту родителя (эластичные цены в Offer),
// название остаётся сверху, цены уходят вниз и встают столбиком, крупнее: в соседних карточках они
// на одной линии, сколько бы места ни было по ширине.
import { formatPrice, type Price } from '../../lib/format';
import type { PriceTable } from '../../data/services';

interface Props {
  table: PriceTable;
  tone?: 'light' | 'dark';
  stretch?: boolean;
}

const { table, tone = 'light', stretch = false } = Astro.props;
const dark = tone === 'dark';
const muted = dark ? 'text-paper/60' : 'text-ink/60';
const two = (table.columns?.length ?? 0) > 1;

type Card = { title: string; note?: string; prices: { label?: string; price: Price; old?: number }[] };
const byColumn = two && table.rows.length === 1;
const row = table.rows[0];
const cards: Card[] = byColumn
  ? [
      { title: table.columns![0], prices: [{ price: row.price, old: row.old }] },
      { title: table.columns![1], prices: [{ price: row.weekend ?? null, old: row.oldWeekend }] },
    ]
  : table.rows.map((r) => ({
      title: r.label,
      note: r.note,
      prices: two
        ? [{ label: table.columns![0], price: r.price, old: r.old }, { label: table.columns![1], price: r.weekend ?? null, old: r.oldWeekend }]
        : [{ price: r.price, old: r.old }],
    }));
const caption = byColumn ? [table.caption, row.label].filter(Boolean).join(' · ') : table.caption;
const n = cards.length;
const narrow = (i: number) => n === 3 || n === 6 || (n === 5 && i < 3);
const span = (i: number) => (n === 1 ? 'sm:col-span-6' : narrow(i) ? 'sm:col-span-2' : 'sm:col-span-3');
---

<div class:list={[stretch && 'lg:flex lg:flex-1 lg:flex-col']}>
  {caption && <p class:list={['label mb-4 font-semibold', dark ? 'text-lime' : 'text-violet']}>{caption}</p>}
  {byColumn && row.note && <p class:list={['-mt-2 mb-4 text-sm', muted]}>{row.note}</p>}
  <ul class:list={['grid gap-3 sm:grid-cols-6', stretch && 'lg:flex-1 lg:auto-rows-fr']}>
    {cards.map((c, i) => (
      <li class:list={['flex flex-col justify-between gap-6 rounded-md p-5 md:p-6', span(i), dark ? 'bg-ink-soft' : 'bg-paper']}>
        <div>
          <p class:list={['font-display text-lg leading-tight font-bold uppercase', narrow(i) ? 'hyphens-auto break-words' : 'md:text-xl']}>{c.title}</p>
          {c.note && <p class:list={['mt-1.5 text-sm leading-snug', muted]}>{c.note}</p>}
        </div>
        <dl class:list={['flex flex-wrap gap-x-10 gap-y-4', stretch && 'lg:flex-col lg:gap-y-5']}>
          {c.prices.map((p) => (
            <div>
              <dt class:list={p.label ? ['label mb-1.5 font-semibold', muted] : 'sr-only'}>{p.label ?? 'Цена'}</dt>
              <dd class="flex flex-wrap items-baseline gap-x-2.5">
                <span class:list={['whitespace-nowrap', p.price === null ? ['text-sm font-semibold', muted] : ['font-display text-2xl font-bold md:text-3xl', stretch && !narrow(i) && 'lg:text-4xl']]}>{formatPrice(p.price, table.empty)}</span>
                {p.old && <span class:list={['text-sm whitespace-nowrap', muted]}><span class="sr-only">вместо </span><s>{formatPrice(p.old)}</s></span>}
              </dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ul>
</div>
