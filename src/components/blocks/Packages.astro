---
// Пакеты праздника колонками: название, состав, цена и доплата за человека. Четыре пакета —
// по 3 колонки, три — по 4, два — по 6, один — на 6. Пустая цена — «Цена по запросу».
import { formatPrice } from '../../lib/format';
import type { Package } from '../../data/parties';

interface Props {
  packages: Package[];
  tone?: 'light' | 'dark';
}

const { packages, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const span = { 4: 'lg:col-span-3', 3: 'lg:col-span-4' }[packages.length] ?? 'lg:col-span-6';
---

<ul class="grid-site gap-y-gutter md:max-lg:grid-cols-2">
  {packages.map((p) => (
    <li class:list={['flex flex-col rounded-md p-6 md:p-7', span, dark ? 'bg-ink-soft' : 'bg-paper']}>
      <h3 class:list={['label font-semibold', dark ? 'text-lime' : 'text-violet']}>{p.name}</h3>
      <ul class="mt-6 mb-8 grid gap-3">
        {p.items.map((item) => (
          <li class="flex gap-3 leading-snug">
            <span class:list={['dash mt-2 block w-3 shrink-0', dark ? 'bg-lime' : 'bg-signal']} aria-hidden="true"></span>{item}
          </li>
        ))}
      </ul>
      <div class:list={['mt-auto border-t pt-6', dark ? 'border-paper/15' : 'border-ink/15']}>
        <p class="font-display text-xl font-bold uppercase">{formatPrice(p.price, 'Цена по запросу')}</p>
        {p.extra !== undefined && (
          <p class:list={['mt-2 text-sm', dark ? 'text-paper/60' : 'text-ink/60']}>Доплата за человека: {formatPrice(p.extra)}</p>
        )}
      </div>
    </li>
  ))}
</ul>
