---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { yclientsId } from '../data/booking';
import CookieConsent from '../components/CookieConsent.astro';
import RequestDialog from '../components/blocks/RequestDialog.astro';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Спортивно-развлекательный комплекс «Вавилон» в Томске: батутная арена, Ninja-трасса, секции и праздники.',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* TODO: виджет онлайн-записи Yclients, включится, когда в src/data/booking.ts появится ID. */}
    {yclientsId && <script is:inline async src={`https://w${yclientsId}.yclients.com/widgetJS`} charset="UTF-8"></script>}
  </head>
  <body class:list={['min-h-dvh overflow-x-clip font-sans', bodyClass]}>
    {/* Первая остановка Tab: мимо логотипа и меню сразу к содержимому (<main id="main"> на каждой странице). */}
    <a href="#main" class="label fixed top-3 left-3 z-[60] -translate-y-24 rounded-md bg-violet px-5 py-3 font-semibold text-paper transition focus-visible:translate-y-0">Перейти к содержимому</a>
    <slot />
    <RequestDialog />
    <CookieConsent />
    <script>
      // Элемент под clip-path: inset(0 0 100% 0) имеет нулевую видимую площадь
      // и не пересекается с экраном, поэтому у масок наблюдаем за родителем.
      const targets = new Map<Element, HTMLElement[]>();
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        const target = el.dataset.reveal === 'mask' && el.parentElement ? el.parentElement : el;
        targets.set(target, [...(targets.get(target) ?? []), el]);
      });
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              targets.get(entry.target)?.forEach((el) => el.classList.add('is-in'));
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      targets.forEach((_, target) => io.observe(target));
    </script>
  </body>
</html>
