---
// Варианты подписей внутри трёх фото первого экрана (замечание 26.10): заказчик выбирает номер,
// выбранный переносим в Hero.astro. Колонки по пропорциям совпадают с правой колонкой героя.
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { photos } from '../../data/photos';

const details = [
  { photo: photos.arena, caption: 'Батутная арена' },
  { photo: photos.ninja, caption: 'Ninja-трасса' },
  { photo: photos.party, caption: 'Праздники' },
];

const variants = [
  { id: 'chip', name: 'Плашка', text: 'Сиреневая плашка в углу кадра, мелкий капс с разрядкой. Текущая версия на главной.' },
  { id: 'skew', name: 'Наклон', text: 'Плашка с наклоном, как заголовки и полосы брендбука, текст широким гротеском.' },
  { id: 'headline', name: 'Заголовок', text: 'Крупная подпись шрифтом заголовков на сиреневом градиенте снизу кадра.' },
  { id: 'bar', name: 'Полоса', text: 'Короткая скошенная сиреневая полоса, под ней белый капс на тёмном градиенте.' },
  { id: 'strip', name: 'Лента', text: 'Сиреневая лента по нижнему краю фото со стрелкой: читается как ссылка.' },
  { id: 'vertical', name: 'Вертикаль', text: 'Подпись идёт вертикально по сиреневой ленте у левого края.' },
  { id: 'number', name: 'Номер', text: 'Сиреневый квадрат с номером 01–03, рядом белый капс.' },
  { id: 'tint', name: 'Тонировка', text: 'Фото тонировано сиреневым, подпись крупно по центру. При наведении цвет возвращается.' },
  { id: 'glass', name: 'Стекло', text: 'Полупрозрачная капсула с размытием и сиреневой точкой, самый тихий вариант.' },
  { id: 'notch', name: 'Вырез', text: 'Угол фото вырезан цветом фона, в вырезе сиреневая подпись. Как вкладка.' },
];
---

<Layout title="Вавилон. Варианты подписей на фото" bodyClass="bg-mist text-ink">
  <main class="px-4 py-12 md:px-8">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <h1 class="headline text-[clamp(2rem,4vw,4.5rem)]">Подписи на фото</h1>
      <p class="max-w-[52ch] text-ink/65">Три фото из правой колонки первого экрана, по пропорциям как на главной. Выберите номер варианта, его и поставим.</p>
    </header>

    <ol class="mt-14 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-5">
      {variants.map((v, n) => (
        <li class="flex flex-col">
          <p class="flex items-baseline gap-3">
            <span class="font-display text-sm font-bold text-violet">{String(n + 1).padStart(2, '0')}</span>
            <span class="font-display text-lg font-bold uppercase">{v.name}</span>
          </p>
          <ul class="mt-4 flex h-[min(78vh,760px)] flex-col gap-4">
            {details.map((d, i) => (
              <li class="group relative min-h-0 flex-1 overflow-hidden rounded-md">
                <Image src={d.photo} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 22vw, 100vw" class="absolute inset-0 size-full object-cover" />

                {v.id === 'chip' && (
                  <span class="label absolute bottom-3 left-3 rounded-sm bg-violet px-3 py-1.5 text-[0.65rem] font-semibold text-paper">{d.caption}</span>
                )}

                {v.id === 'skew' && (
                  <span class="absolute bottom-4 left-4 -skew-x-12 rounded-sm bg-violet px-3 py-1.5 font-display text-sm font-extrabold tracking-tight text-paper uppercase">{d.caption}</span>
                )}

                {v.id === 'headline' && (
                  <>
                    <span class="absolute inset-x-0 bottom-0 h-2/3 bg-linear-to-t from-violet-deep via-violet/40 to-transparent"></span>
                    <span class="headline absolute bottom-4 left-5 max-w-[80%] text-[clamp(1.1rem,1.5vw,2rem)] text-paper">{d.caption}</span>
                  </>
                )}

                {v.id === 'bar' && (
                  <>
                    <span class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-ink/85 to-transparent"></span>
                    <span class="absolute bottom-4 left-4">
                      <span class="block h-1.5 w-10 -skew-x-[28deg] bg-violet"></span>
                      <span class="label mt-2 block text-[0.7rem] font-semibold text-paper">{d.caption}</span>
                    </span>
                  </>
                )}

                {v.id === 'strip' && (
                  <span class="label absolute inset-x-0 bottom-0 flex items-center justify-between bg-violet px-4 py-2.5 text-[0.65rem] font-semibold text-paper">
                    {d.caption}<Icon name="arrowUpRight" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </span>
                )}

                {v.id === 'vertical' && (
                  <span class="absolute inset-y-0 left-0 flex w-9 items-center justify-center bg-violet">
                    <span class="label rotate-180 text-[0.65rem] font-semibold whitespace-nowrap text-paper [writing-mode:vertical-rl]">{d.caption}</span>
                  </span>
                )}

                {v.id === 'number' && (
                  <>
                    <span class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-ink/80 to-transparent"></span>
                    <span class="absolute bottom-3 left-3 flex items-center gap-3">
                      <span class="grid size-8 place-items-center rounded-sm bg-violet font-display text-xs font-bold text-paper">{String(i + 1).padStart(2, '0')}</span>
                      <span class="label text-[0.65rem] font-semibold text-paper">{d.caption}</span>
                    </span>
                  </>
                )}

                {v.id === 'tint' && (
                  <>
                    <span class="absolute inset-0 bg-violet mix-blend-multiply transition-opacity duration-500 group-hover:opacity-0"></span>
                    <span class="absolute inset-0 grid place-items-center p-4 text-center">
                      <span class="font-display text-[clamp(1rem,1.3vw,1.75rem)] font-extrabold tracking-tight text-paper uppercase">{d.caption}</span>
                    </span>
                  </>
                )}

                {v.id === 'glass' && (
                  <span class="label absolute bottom-3 left-3 flex items-center gap-2 rounded-full border border-paper/35 bg-ink/30 px-3 py-1.5 text-[0.65rem] font-semibold text-paper backdrop-blur-md">
                    <span class="size-1.5 rounded-full bg-violet"></span>{d.caption}
                  </span>
                )}

                {v.id === 'notch' && (
                  <span class="label absolute bottom-0 left-0 rounded-tr-md bg-mist pt-2 pr-4 text-[0.7rem] font-semibold text-violet">{d.caption}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-ink/65">{v.text}</p>
        </li>
      ))}
    </ol>
  </main>
</Layout>
