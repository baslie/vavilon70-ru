---
// Выпускные: вводная из ТЗ, вкладки «Сады | Школа | Старшеклассники» с условным наполнением
// (открытый вопрос #6), безопасность для родителей и форма расчёта.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Tabs from '../../components/blocks/Tabs.astro';
import Packages from '../../components/blocks/Packages.astro';
import RequestForm from '../../components/blocks/RequestForm.astro';
import Button from '../../components/blocks/Button.astro';
import Safety from '../../components/sections/Safety.astro';
import { graduation } from '../../data/parties';
import { forms } from '../../data/forms';
import { url } from '../../data/nav';
---

<Layout title="Выпускные — Вавилон" description="Выпускной и окончание учебного года в «Вавилоне», Томск: программы для детских садов, школьников и старшеклассников — батуты, Ninja-трасса, командные челленджи." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={graduation.title} crumbs={[{ title: 'Праздники', href: url('/prazdniki/') }, { title: 'Детские праздники' }]} lead={graduation.lead} photo="football">
      <Button href="#zayavka" icon="confetti">{forms.party.title}</Button>
      <a href="#programmy" class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">Программы</a>
    </PageHero>

    <section id="programmy" class="bg-ink px-4 py-20 text-paper md:px-8 lg:py-24">
      <h2 class="headline text-[clamp(1.9rem,3.6vw,3.75rem)] leading-[1.02]" data-reveal>Программы выпускных</h2>
      <div class="mt-10">
        <Tabs tabs={graduation.groups} label="Для кого выпускной" tone="dark">
          {graduation.groups.map((g) => <div slot={g.id}><Packages packages={g.packages} tone="dark" /></div>)}
        </Tabs>
      </div>
    </section>

    <Safety />
    <RequestForm id="zayavka" form={forms.party} />
  </main>
  <Footer />
</Layout>
