---
// Детский день рождения: пакеты по возрастам во вкладках (ТЗ: «Дети 4–7 лет | Дети 8–18 лет»),
// под ними доплата и стол в кафе, шаги праздника, дополнительные опции карточками-ссылками
// в «Дополнительно» и «Семейное кафе» (просьба заказчика 06.11.2026), форма расчёта стоимости.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Tabs from '../../components/blocks/Tabs.astro';
import Packages from '../../components/blocks/Packages.astro';
import Steps from '../../components/blocks/Steps.astro';
import CardGrid, { type Card } from '../../components/blocks/CardGrid.astro';
import RequestForm from '../../components/blocks/RequestForm.astro';
import Button from '../../components/blocks/Button.astro';
import { birthday, facePainting, photographer } from '../../data/parties';
import { forms } from '../../data/forms';
import { url } from '../../data/nav';

const { extras } = birthday;
const cards: Card[] = [
  { title: facePainting.title, text: extras.items.facePainting, href: url('/prazdniki/dopolnitelno/#akvagrim'), photo: facePainting.photo, meta: 'Раздел «Дополнительно»' },
  { title: photographer.title, text: extras.items.photographer, href: url('/prazdniki/dopolnitelno/#fotograf'), photo: photographer.photo, meta: 'Раздел «Дополнительно»' },
  { title: 'Стильное оформление стола', text: extras.items.decor, href: url('/kafe/#ukrashenie'), photo: 'decor', meta: 'Раздел «Семейное кафе»' },
];
---

<Layout title="День рождения — Вавилон" description="Детский день рождения под ключ в «Вавилоне», Томск: пакеты для детей 4–7 и 8–18 лет от 8 100 ₽ — аниматоры, Ninja-трасса, батутная арена и семейное кафе." bodyClass="bg-mist text-ink">
  <Header />

  <main id="main">
    <PageHero title={birthday.title} crumbs={[{ title: 'Праздники', href: url('/prazdniki/') }]} current="День рождения" lead={birthday.lead} photo="party">
      <Button href="#zayavka" icon="confetti">{forms.party.title}</Button>
      <Button href="#pakety" variant="outline">Пакеты</Button>
    </PageHero>

    <section id="pakety" class="bg-ink px-4 py-20 text-paper md:px-8 lg:py-24">
      <h2 class="headline text-[clamp(1.9rem,3.6vw,3.75rem)] leading-[1.02]" data-reveal>Пакеты праздника</h2>
      <div class="mt-10">
        <Tabs tabs={birthday.groups} label="Возраст гостей" tone="dark">
          {birthday.groups.map((g) => <div slot={g.id}><Packages packages={g.packages} tone="dark" topic={g.id === 'deti-4-7' ? 'День рождения 4–7 лет' : 'День рождения 8–18 лет'} perHead="с ребёнка" /></div>)}
        </Tabs>
      </div>
      <ul class="grid-site mt-16 gap-y-10">
        {birthday.notes.map((n, i) => (
          <li class:list={['lg:col-span-5', i > 0 && 'lg:col-start-7']} data-reveal style={`--i:${i}`}>
            <span class="dash mb-4 block bg-lime" aria-hidden="true"></span>
            <p class="subhead">{n.title}</p>
            <p class="mt-2 leading-relaxed text-paper/70">{n.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <Steps id="kak-prohodit" title={birthday.steps.title} items={birthday.steps.items} />
    <CardGrid id="dopolnitelno" title={extras.title} lead={extras.lead} items={cards} tone="dark" />
    <RequestForm id="zayavka" form={forms.party} tone="light" />
  </main>
  <Footer />
</Layout>
