---
// Детский день рождения: пакеты по возрастам во вкладках (ТЗ: «Дети 4–7 лет | Дети 8–18 лет»),
// дополнительные услуги и кафе карточками, форма расчёта стоимости.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Tabs from '../../components/blocks/Tabs.astro';
import Packages from '../../components/blocks/Packages.astro';
import CardGrid, { type Card } from '../../components/blocks/CardGrid.astro';
import RequestForm from '../../components/blocks/RequestForm.astro';
import Button from '../../components/blocks/Button.astro';
import { birthday, facePainting, photographer } from '../../data/parties';
import { forms } from '../../data/forms';
import { url } from '../../data/nav';

const extras: Card[] = [
  { title: facePainting.title, text: 'Любимые персонажи, маски супергероев и неоновые рисунки, которые светятся в темноте.', href: url('/prazdniki/dopolnitelno/#akvagrim'), photo: facePainting.photo },
  { title: photographer.title, text: 'Самые яркие эмоции в полёте, на Ninja-трассе и во время вручения торта.', href: url('/prazdniki/dopolnitelno/#fotograf'), photo: photographer.photo },
  { title: 'Семейное кафе', text: 'Тематическое украшение, сервировка и горячая пицца точно к концу программы.', href: url('/kafe/') },
];
---

<Layout title="День рождения — Вавилон" description="Детский день рождения под ключ в «Вавилоне», Томск: пакеты для детей 4–7 и 8–18 лет, аниматоры, Ninja-трасса, батутная арена и семейное кафе." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={birthday.title} crumbs={[{ title: 'Праздники', href: url('/prazdniki/') }, { title: 'Детские праздники' }]} lead={birthday.lead} photo="party">
      <Button href="#zayavka" icon="confetti">{forms.party.title}</Button>
      <a href="#pakety" class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">Пакеты</a>
    </PageHero>

    <section id="pakety" class="bg-ink px-4 py-20 text-paper md:px-8 lg:py-24">
      <h2 class="headline text-[clamp(1.9rem,3.6vw,3.75rem)] leading-[1.02]" data-reveal>Пакеты праздника</h2>
      <div class="mt-10">
        <Tabs tabs={birthday.groups} label="Возраст гостей" tone="dark">
          {birthday.groups.map((g) => <div slot={g.id}><Packages packages={g.packages} tone="dark" /></div>)}
        </Tabs>
      </div>
    </section>

    <CardGrid title="Дополните праздник" items={extras} />
    <RequestForm id="zayavka" form={forms.party} />
  </main>
  <Footer />
</Layout>
