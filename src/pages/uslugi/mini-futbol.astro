---
// Аренда футбольной арены. Вместимости пока нет (открытый вопрос #1): «Уточняется»,
// кнопка ведёт на форму заявки внизу страницы. Форма заменяет общий призыв к действию.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Offer from '../../components/blocks/Offer.astro';
import RequestForm from '../../components/blocks/RequestForm.astro';
import Button from '../../components/blocks/Button.astro';
import { arena, complexTicket } from '../../data/services';
import { forms } from '../../data/forms';
import { url } from '../../data/nav';
---

<Layout title="Мини-футбол — Вавилон" description="Аренда крытой футбольной арены с мягким искусственным газоном в «Вавилоне», Томск: для друзей, дней рождения, корпоративных турниров и тренировок." bodyClass="bg-mist text-ink">
  <Header />

  <main id="main">
    <PageHero title={arena.title} crumbs={[{ title: 'Услуги и цены', href: url('/uslugi/') }]} current="Мини-футбол" lead={arena.intro?.text} photo={arena.photo}>
      <Button href="#zayavka" icon="lightning">{arena.cta.label}</Button>
      <Button href={`#${arena.id}`} variant="outline">Цены и условия</Button>
    </PageHero>
    <Offer offer={arena} tone="dark" title="Цены и условия" showIntro={false} />
    <Offer offer={complexTicket} photo />
    <RequestForm id="zayavka" form={forms.arena} />
  </main>
  <Footer />
</Layout>
