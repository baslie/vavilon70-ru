---
// Ninja-трасса — эталон шаблона внутренней страницы услуги (docs/TZ.md, открытый вопрос #27).
// Поля чередуются, как на главной: светлый первый экран, тёмные цены и условия, светлый
// комплексный билет, тёмная подготовка к визиту, светлая безопасность, тёмный призыв.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Offer from '../../components/blocks/Offer.astro';
import Steps from '../../components/blocks/Steps.astro';
import Button from '../../components/blocks/Button.astro';
import Safety from '../../components/sections/Safety.astro';
import PlanVisit from '../../components/sections/PlanVisit.astro';
import { ninja, complexTicket, visitSteps } from '../../data/services';
import { url } from '../../data/nav';
---

<Layout title="Ninja-трасса — Вавилон" description="Первая в Томске полоса препятствий Ninja-трасса в «Вавилоне»: рукоходы, подвесные элементы и балансиры, прохождение на время. Цены от 350 ₽." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={ninja.title} crumbs={[{ title: 'Услуги и цены', href: url('/uslugi/') }, { title: 'Свободные посещения' }]} badges={ninja.badges} lead={ninja.intro?.text} photo={ninja.photo}>
      <Button icon="lightning">{ninja.cta.label}</Button>
      <a href="#ninja" class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">Цены и условия</a>
    </PageHero>
    <Offer offer={ninja} tone="dark" title="Цены и условия" showIntro={false} />
    <Offer offer={complexTicket} photo />
    <Steps title={visitSteps.title} items={visitSteps.items} tone="dark" />
    <Safety />
    <PlanVisit />
  </main>
  <Footer />
</Layout>
