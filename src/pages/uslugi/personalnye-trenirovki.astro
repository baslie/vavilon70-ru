---
// Персональные тренировки с инструктором по шаблону Ninja-трассы: первый экран, цены и условия,
// тренеры, призыв.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Offer from '../../components/blocks/Offer.astro';
import Coaches from '../../components/blocks/Coaches.astro';
import Button from '../../components/blocks/Button.astro';
import PlanVisit from '../../components/sections/PlanVisit.astro';
import { personal } from '../../data/services';
import { url } from '../../data/nav';
---

<Layout title="Тренировки с инструктором — Вавилон" description="Персональные тренировки на батутах с инструктором в «Вавилоне», Томск: индивидуально, вдвоём или мини-группой. От 1 500 ₽ за час." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={personal.title} crumbs={[{ title: 'Услуги и цены', href: url('/uslugi/') }, { title: 'Тренировки и секции' }]} badges={personal.badges} lead={personal.intro?.text} photo={personal.photo}>
      <Button icon="lightning">{personal.cta.label}</Button>
      <a href={`#${personal.id}`} class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">Цены и условия</a>
    </PageHero>
    <Offer offer={personal} tone="dark" title="Цены и условия" showIntro={false} />
    <Coaches />
    <PlanVisit />
  </main>
  <Footer />
</Layout>
