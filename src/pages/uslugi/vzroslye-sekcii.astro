---
// Взрослые секции 18+: фристайл (#fristajl), Ninja-трасса «скоро» (#ninja) с формой «Узнать
// о старте группы» (#start, открытый вопрос #10), тренеры и первая тренировка.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Offer from '../../components/blocks/Offer.astro';
import RequestForm from '../../components/blocks/RequestForm.astro';
import Coaches from '../../components/blocks/Coaches.astro';
import Steps from '../../components/blocks/Steps.astro';
import { adults, adultFreestyle, adultNinja, firstTraining } from '../../data/classes';
import { forms } from '../../data/forms';
import { url } from '../../data/nav';
---

<Layout title="Взрослые секции — Вавилон" description="Секции для взрослых 18+ в «Вавилоне», Томск: батутный фристайл и Ninja-трасса. Альтернативный фитнес с опытными инструкторами." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={adults.title} crumbs={[{ title: 'Услуги и цены', href: url('/uslugi/') }, { title: 'Тренировки и секции' }]} badges={['18+']} lead={adults.lead} photo="jumpTall">
      <ul class="label flex flex-wrap gap-x-7 gap-y-3 font-semibold">
        {[adultFreestyle, adultNinja].map((s) => <li><a href={`#${s.id}`} class="underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">{s.title}</a></li>)}
      </ul>
    </PageHero>
    <Offer offer={adultFreestyle} tone="dark" photo />
    <Offer offer={adultNinja} photo />
    <RequestForm id="start" form={forms.ninjaStart} />
    <Coaches />
    <Steps title={firstTraining.title} items={firstTraining.items} tone="dark" />
  </main>
  <Footer />
</Layout>
