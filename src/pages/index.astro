---
// Витрина прототипов для заказчика: ссылки на варианты первого экрана.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Stripes from '../components/Stripes.astro';
import { photos } from '../data/photos';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [
  {
    title: 'Исходные',
    note: 'В языке брендбука формы: Unbounded, Onest, спокойная сетка.',
    variants: [
      { href: `${base}/v1/`, num: '01', name: 'Брендбук', text: 'Раскладка доски с формой: светлое поле, фото по центру, справа колонка деталей.', photo: photos.jumpTall, bar: 'bg-violet' },
      { href: `${base}/v2/`, num: '02', name: 'Форма', text: 'Тёмный, как сама футболка. Прыжок в косом кадре поверх ткани с молниями.', photo: photos.texture, bar: 'bg-signal' },
      { href: `${base}/v3/`, num: '03', name: 'Постер', text: 'Огромный заголовок во всю ширину, широкое фото и столбик слов с красным тире.', photo: photos.jump, bar: 'bg-paper' },
    ],
  },
  {
    title: 'Через frontend-design',
    note: 'Те же три идеи, доведённые до крайности. Палитра и логотип прежние, шрифты заголовков и движение новые.',
    variants: [
      { href: `${base}/v4/`, num: '04', name: 'Спецификация', twin: 'Брендбук', text: 'Технический лист: волосяная сетка, метки обреза, фото арены с пронумерованными выносками.', photo: photos.arena, bar: 'bg-violet' },
      { href: `${base}/v5/`, num: '05', name: 'Ночная арена', twin: 'Форма', text: 'Кадр во весь экран, прожектор идёт за курсором, зерно плёнки и бегущая строка.', photo: photos.jump, bar: 'bg-signal' },
      { href: `${base}/v6/`, num: '06', name: 'Плакат-манифест', twin: 'Постер', text: 'Сжатый гротеск во всю ширину, фото вплетено между строк, плашки кренятся от скролла.', photo: photos.jumpTall, bar: 'bg-paper' },
    ],
  },
];
---

<Layout title="Вавилон. Варианты первого экрана" bodyClass="bg-mist text-ink">
  <main class="mx-auto flex min-h-dvh max-w-[1100px] flex-col justify-center px-4 py-16 md:px-8">
    <div class="flex items-start justify-between gap-6">
      <Logo class="w-40" caption />
      <Stripes class="h-6 w-40" />
    </div>
    <h1 class="headline mt-16 max-w-[16ch] text-4xl md:text-6xl">Шесть вариантов первого экрана</h1>
    <p class="mt-6 max-w-[52ch] text-ink/70">Прототипы для выбора направления. Первые три в языке брендбука формы, следующие три — их смелые двойники. Фото временные, сгенерированы до съёмки в зале. Тексты и цифры из ТЗ.</p>

    {groups.map((g, gi) => (
      <section class="mt-14" aria-labelledby={`group-${gi}`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-ink/20 pt-4">
          <h2 id={`group-${gi}`} class="label font-semibold">{g.title}</h2>
          <p class="max-w-[60ch] text-sm text-ink/60">{g.note}</p>
        </div>
        <ol class="mt-5 grid gap-4 md:grid-cols-3">
          {g.variants.map((v, i) => (
            <li>
              <a href={v.href} class="flex h-full flex-col rounded-md border border-ink/15 bg-paper/60 p-3 hover:border-ink/40">
                <span class="relative block aspect-[4/3] overflow-hidden rounded-md bg-ink">
                  <Image src={v.photo} alt="" widths={[400, 700]} sizes="(min-width: 768px) 30vw, 100vw" class="size-full object-cover" />
                  <span class:list={['absolute bottom-5 left-5 h-2 w-14 -skew-x-[28deg]', v.bar]}></span>
                </span>
                <span class="flex items-center justify-between px-2 pt-5 font-display text-lg font-bold uppercase">
                  <span><span class="mr-2 text-ink/35">{v.num}</span>{v.name}</span><Icon name="arrowUpRight" class="size-5" />
                </span>
                {'twin' in v && <span class="label px-2 pt-1 text-violet">Двойник «{v.twin}»</span>}
                <span class="px-2 pt-2 pb-3 text-sm leading-relaxed text-ink/65">{v.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Layout>
