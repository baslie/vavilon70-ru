---
// Семейное кафе: преимущества, меню (#menu) с карточкой PDF, тематическое украшение (#ukrashenie)
// с пакетами-заглушками, предзаказ банкетного стола и форма «Согласовать банкетное меню».
// Своих фото кафе нет (открытый вопрос #16): в первом экране кадр с праздника.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/blocks/PageHero.astro';
import EventSection from '../components/blocks/EventSection.astro';
import Steps from '../components/blocks/Steps.astro';
import RequestForm from '../components/blocks/RequestForm.astro';
import DownloadLink from '../components/blocks/DownloadLink.astro';
import Button from '../components/blocks/Button.astro';
import { cafe, menu, decor, preorder } from '../data/cafe';
import { forms } from '../data/forms';
import { url } from '../data/nav';
---

<Layout title="Семейное кафе — Вавилон" description="Семейное кафе «Вавилона» в Томске: пицца, бургеры, десерты и напитки в отдельном зале, тематическое украшение и банкетный стол к празднику." bodyClass="bg-mist text-ink">
  <Header />

  <main>
    <PageHero title={cafe.title} crumbs={[{ title: 'Праздники', href: url('/prazdniki/') }, { title: 'Семейное кафе' }]} lead={cafe.lead} photo="party">
      <Button href="#zayavka" icon="confetti">{forms.banquet.title}</Button>
      <a href="#menu" class="label font-semibold underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-violet">Меню</a>
    </PageHero>

    <section class="grid-site gap-y-12 bg-ink px-4 py-20 text-paper md:px-8 lg:py-24">
      <ul class="grid gap-x-gutter gap-y-12 md:grid-cols-2 lg:col-span-12 lg:grid-cols-subgrid">
        {cafe.advantages.map((a, i) => (
          <li class="lg:col-span-3" data-reveal style={`--i:${i}`}>
            <span class="dash mb-5 block bg-lime" aria-hidden="true"></span>
            <h2 class="font-display text-lg font-bold uppercase">{a.title}</h2>
            <p class="mt-3 leading-relaxed text-paper/70">{a.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="menu" class="grid-site gap-y-12 px-4 py-20 md:px-8 lg:py-24">
      <h2 class="headline text-[clamp(1.9rem,3.6vw,3.75rem)] leading-[1.02] lg:col-span-12" data-reveal>{menu.title}</h2>
      <ul class="grid gap-x-gutter gap-y-12 md:grid-cols-2 lg:col-span-12 lg:grid-cols-subgrid">
        {menu.categories.map((c, i) => (
          <li class="lg:col-span-3" data-reveal style={`--i:${i}`}>
            <span class="dash mb-5 block bg-signal" aria-hidden="true"></span>
            <h3 class="font-display text-lg font-bold uppercase">{c.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/70">{c.text}</p>
          </li>
        ))}
      </ul>
      <div class="rounded-md bg-paper p-6 md:p-10 lg:col-span-8" data-reveal>
        <p class="font-display text-xl font-bold uppercase md:text-2xl">{menu.pdf.title}</p>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-ink/70">{menu.pdf.text}</p>
        <p class="mt-8"><DownloadLink href={menu.pdf.href}>{menu.pdf.label}</DownloadLink></p>
      </div>
    </section>

    <EventSection event={decor} tone="dark" />
    <Steps id="predzakaz" title={preorder.title} items={preorder.items} />
    <RequestForm id="zayavka" form={forms.banquet} />
  </main>
  <Footer />
</Layout>
