---
// Вариант 2. «Форма»: тёмный, как сама футболка. Прыжок в косом кадре поверх ткани с молниями,
// текст спокойный, энергия только в фото.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Stripes from '../components/Stripes.astro';
import { hero, contacts, facts, directions, slogans } from '../data/content';
import { photos, alts } from '../data/photos';

// Бенто: первая плитка крупная, кафе на фирменной ткани.
const spans = ['md:col-span-4 md:row-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2'];
---

<Layout title="Вавилон. Вариант 2: форма" bodyClass="bg-ink text-paper">
  <Header tone="light" />

  <main>
    <section class="grid gap-10 px-4 pt-4 pb-10 md:px-8 lg:h-[calc(100dvh-5.5rem)] lg:min-h-[620px] lg:grid-cols-12 lg:grid-rows-[1fr_auto] lg:gap-x-8 lg:gap-y-6 lg:pb-8">
      <div class="flex flex-col justify-center gap-10 lg:col-span-5">
        <p class="label flex flex-wrap gap-x-3 text-paper/55">
          {slogans.values.map((w, i) => <>{i > 0 && <span class="text-paper/25">/</span>}<span>{w}</span></>)}
        </p>
        <h1 class="headline text-[clamp(2.75rem,5.6vw,8rem)]">
          <span class="block">Больше</span>
          <span class="block">чем прыжки</span>
        </h1>
        <span class="-mt-4 h-1 w-12 bg-signal" aria-hidden="true"></span>
        <div class="grid gap-8">
          <p class="max-w-[36ch] text-lg leading-relaxed text-paper/70">{hero.lead}</p>
          <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="#" class="label inline-flex items-center gap-3 rounded-md bg-violet px-6 py-4 font-semibold text-paper transition hover:bg-paper hover:text-ink active:scale-[0.98]">
              {hero.primary}<Icon name="arrowUpRight" class="size-4" />
            </a>
            <a href="#" class="label font-semibold underline decoration-paper/30 underline-offset-[6px] transition hover:decoration-signal">{hero.secondary}</a>
          </div>
        </div>
      </div>

      <figure class="relative isolate min-h-[420px] overflow-hidden rounded-md lg:col-span-7 lg:min-h-0">
        <Image src={photos.texture} alt="" widths={[800, 1400]} sizes="(min-width: 1024px) 55vw, 100vw" loading="eager" class="absolute inset-0 -z-10 size-full object-cover" />
        <Image src={photos.jump} alt={alts.jump} widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 55vw, 100vw" loading="eager" fetchpriority="high" quality={82} class="absolute inset-y-0 right-0 h-full w-[88%] object-cover object-[65%_center] [clip-path:polygon(18%_0,100%_0,100%_100%,0_100%)]" />
        <figcaption class="label absolute bottom-5 left-5 flex items-center gap-2 text-paper/85"><Icon name="mapPin" class="size-4" />{contacts.place}</figcaption>
      </figure>

      <div class="hidden items-center gap-6 lg:col-span-12 lg:flex" aria-hidden="true">
        <p class="label flex gap-6 text-paper/60">{slogans.motto.map((w) => <span>{w}</span>)}</p>
        <span class="h-px flex-1 bg-paper/25"></span>
        <Stripes class="h-6 w-44" onDark />
        <span class="h-px flex-1 bg-paper/25"></span>
        <Icon name="arrowUpRight" class="size-9" />
      </div>
    </section>

    <section class="border-y border-paper/10" aria-label="Вавилон в цифрах">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {facts.map((f, i) => (
          <div class="border-paper/10 px-4 py-10 md:px-8 md:py-14 [&:nth-child(odd)]:border-r lg:[&:not(:last-child)]:border-r" data-reveal style={`--i:${i}`}>
            <p class="headline text-4xl md:text-5xl">{f.value}</p>
            <p class="label mt-3 text-violet">{f.unit}</p>
            <p class="mt-2 max-w-[24ch] text-sm leading-relaxed text-paper/60">{f.label}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="px-4 py-24 md:px-8">
      <div class="flex items-end gap-6">
        <h2 class="headline text-4xl md:text-6xl" data-reveal>Что внутри</h2>
        <span class="mb-2 h-1 w-10 bg-signal" aria-hidden="true"></span>
      </div>
      <div class="mt-12 grid auto-rows-[260px] gap-3 md:grid-cols-6 md:auto-rows-[240px]">
        {directions.map((d, i) => (
          <a href="#" class:list={['group relative isolate flex flex-col justify-end overflow-hidden rounded-md p-6', spans[i]]} data-reveal style={`--i:${i % 3}`}>
            <Image src={d.photo ? photos[d.photo] : photos.textureAlt} alt="" widths={[600, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent" aria-hidden="true"></div>
            <h3 class="font-display text-xl font-bold uppercase md:text-2xl">{d.title}</h3>
            <p class="mt-2 max-w-[34ch] text-sm leading-relaxed text-paper/75">{d.text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
